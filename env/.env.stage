# Build-time config for the stage site. Loaded by `env-cmd` from the npm build/start scripts (package.json).
# Public values only. Secrets (AUTH_SECRET, GHOST_CONTENT_API_KEY, GOOGLE_CLIENT_ID/SECRET) are never
# committed: Vercel reads them from the project's Environment Variables, Cloudflare Workers from
# `wrangler secret`, and the GitHub Actions build from repository secrets.

# Ghost CMS
GHOST_CONTENT_API_URL=https://blog.dev.astrosewa.com
GHOST_CONTENT_API_VERSION=v5.0

# Public
NEXT_PUBLIC_BACKEND_URL=https://api.stage.astrosewa.com/api/v1
NEXT_PUBLIC_SITE_URL=https://stage.astrosewa.com/
NEXT_PUBLIC_GA_ID=G-2FMF9DM99H

# Logging
LOG_LEVEL=info

# NextAuth v5 (admin login)
AUTH_URL=https://stage.astrosewa.com
