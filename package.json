{
  "name": "astro-sewa-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "env-cmd -f env/.env.prod next build",
    "build:test": "env-cmd -f env/.env.test next build",
    "build:stage": "env-cmd -f env/.env.stage next build",
    "postbuild": "npx next-sitemap",
    "start": "env-cmd -f env/.env.prod next start",
    "start:test": "env-cmd -f env/.env.test next start",
    "start:stage": "env-cmd -f env/.env.stage next start",
    "cf:build": "npm run build && opennextjs-cloudflare build --skipNextBuild && node -e \"require('fs').copyFileSync('cloudflare/_headers', '.open-next/assets/_headers')\"",
    "cf:build:test": "npm run build:test && opennextjs-cloudflare build --skipNextBuild --env test && node -e \"require('fs').copyFileSync('cloudflare/_headers', '.open-next/assets/_headers')\"",
    "cf:preview:test": "opennextjs-cloudflare preview --env test",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:deploy:test": "opennextjs-cloudflare deploy --env test",
    "check:images": "node scripts/check-image-sizes.mjs",
    "test": "vitest run",
    "prepare": "husky",
    "lint": "eslint . --fix",
    "format": "prettier --write \"{app,components}/**/*.{ts,tsx,js,jsx,json,css,scss}\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.100.3",
    "@tanstack/react-table": "^8.21.3",
    "@tryghost/content-api": "^1.12.0",
    "@types/swiper": "^5.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "livekit-client": "2.22.4",
    "lucide-react": "^1.11.0",
    "moment": "^2.30.1",
    "nepali-date-converter": "^3.4.0",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.31",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.5.6",
    "qrcode": "1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.73.1",
    "react-icons": "^5.5.0",
    "socket.io-client": "4.8.4",
    "suncalc": "^1.9.0",
    "swiper": "^12.0.2",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@opennextjs/cloudflare": "1.20.14",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^20",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/suncalc": "^1.9.2",
    "@types/tryghost__content-api": "^1.3.17",
    "env-cmd": "^11.0.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.1.6",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5",
    "vitest": "4.1.12",
    "wrangler": "4.154.0"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
